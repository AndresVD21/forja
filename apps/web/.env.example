# Neon connection string. Leave unset in local development to use the PGlite folder .data/pglite.
DATABASE_URL=
# Signs session cookies. At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public address of the app, used for redirects and cookies: http://localhost:3000 locally.
# `pnpm invite` also builds its links from it.
BETTER_AUTH_URL=
# Local development only, never in production. `pnpm db:reset-local` creates this user in the local database.
DEV_TEST_EMAIL=
DEV_TEST_PASSWORD=
