# Neon connection string. Leave unset in local development to use the PGlite folder .data/pglite.
DATABASE_URL=
# Signs session cookies. At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public address of the app, used for redirects and cookies: http://localhost:3000 locally.
BETTER_AUTH_URL=
# Google OAuth client id; Google sign-in appears only when this and the secret are both set.
GOOGLE_CLIENT_ID=
# Google OAuth client secret. Redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_SECRET=
