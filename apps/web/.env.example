# Neon connection string (the pooled one). Leave unset in local development to use the PGlite folder .data/pglite.
# On Vercel, Neon's integration sets it for you (a separate Neon branch per preview deployment).
DATABASE_URL=
# Neon's direct (not pooled) connection string. Set by Neon's Vercel integration; leave empty locally.
# Only the build's migrate and catalogue-seed scripts use it (Neon advises direct connections for schema
# changes); the running app keeps using DATABASE_URL. Without it they fall back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Signs session cookies. At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public address of the app, used for redirects and cookies: http://localhost:3000 locally.
# `pnpm invite` also builds its links from it.
# On Vercel set it for PRODUCTION ONLY (the real URL). Preview deployments ignore it: they use Vercel's own
# VERCEL_BRANCH_URL / VERCEL_URL (see src/server/auth-settings.ts).
BETTER_AUTH_URL=
# Local development only. NEVER set these on Vercel (any environment). `pnpm db:reset-local` creates this user
# in the local database.
DEV_TEST_EMAIL=
DEV_TEST_PASSWORD=
