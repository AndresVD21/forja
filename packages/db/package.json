{
  "name": "@forja/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./local": "./src/local.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed-catalogue": "tsx src/scripts/seed-catalogue.ts",
    "db:seed-user": "tsx src/scripts/seed-user.ts",
    "invite": "tsx --env-file-if-exists=../../apps/web/.env.local src/scripts/invite.ts",
    "invite:list": "tsx --env-file-if-exists=../../apps/web/.env.local src/scripts/invite-list.ts",
    "invite:revoke": "tsx --env-file-if-exists=../../apps/web/.env.local src/scripts/invite-revoke.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@forja/core": "workspace:*",
    "@neondatabase/serverless": "^1.2.1",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@forja/config": "workspace:*",
    "@types/node": "^22",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
